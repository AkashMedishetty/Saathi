name: Quick: Hindi font result opens slider
start-activity android.settings.SETTINGS
expect focus "com.android.settings" within 5
say HI अक्षर बड़े करो
expect show key=map_settings_font_[012] within 10
if show key=map_settings_font_0
tap-glow
expect show key=map_settings_font_[12] within 8
endif
if show key=map_settings_font_1
doit
expect show key=map_settings_font_2 within 8
endif
tap-glow
expect log "\[settle\] settings_font: slider" within 10
expect enabled
