name: Spoken WhatsApp choice reaches top-bar video call
requires-installed com.whatsapp
# Operator: choice enabled, WhatsApp logged in, son's matching chat already open.
# The call button only glows; no tap or Do it is sent to it.
say EN video call my son
expect log "\[choice\] choose_video" within 15
say EN WhatsApp
expect show key=map_wa_video_call_3 within 15
expect bounds top < 500
expect enabled
