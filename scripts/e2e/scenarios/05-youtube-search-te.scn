name: YouTube search and playback (TE)
apps: com.google.android.youtube
# A7/B10/B11. Checks the suggestion (go) path; no arbitrary first-video coordinates.
say TE యూట్యూబ్‌లో పాత తెలుగు పాటలు వెతుకు
expect show key=search within 15
tap-glow
expect show key=type within 10
doit
expect show key=go within 12
tap-glow
expect show key=pick within 15
tap-glow
expect log "\[finish\]|\[show\] key=ad_" within 20
expect enabled
